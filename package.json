{
  "name": "agentcrashlab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "eve build --skip-sandbox-prewarm && next build",
    "start": "node scripts/dev.mjs --production",
    "typecheck": "tsc --noEmit",
    "test:engine": "PYTHONPATH=engine python3 -m unittest discover -s tests -v",
    "test:e2e": "playwright test",
    "cli": "PYTHONPATH=engine python3 -m agentcrashlab",
    "format": "prettier --write app agent lib scripts tests/browser next.config.ts playwright.config.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.104",
    "@ai-sdk/openai-compatible": "3.0.80",
    "ai": "7.0.156",
    "eve": "0.86.0",
    "lucide-react": "0.577.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
